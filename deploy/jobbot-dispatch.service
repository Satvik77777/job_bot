[Unit]
Description=Discover when due and send at most one eligible application for Satvik
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jobbot
Group=jobbot
WorkingDirectory=/opt/satvik-jobbot
EnvironmentFile=/opt/satvik-jobbot/.env
ExecStart=/usr/bin/python3 /opt/satvik-jobbot/jobbot.py tick
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/satvik-jobbot/data /opt/satvik-jobbot/output
